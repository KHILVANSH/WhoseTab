<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayCardRoot"
    android:layout_width="304dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_card_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: Title + Amount + Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid ₹0.00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Merchant"
                android:textColor="#A1A1AA"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlayCloseBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#71717A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contacts Quick Select Area -->
    <LinearLayout
        android:id="@+id/overlayContactsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ADD TO TAB"
                android:textColor="#71717A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayIncludeMeChip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/overlay_chip_bg"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="Split with me"
                android:textColor="#D4D4D8"
                android:textSize="11sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/overlayChipsList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayOpenAppBtn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/overlay_btn_secondary"
            android:gravity="center"
            android:text="Open App"
            android:textColor="#E4E4E7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayQuickAddBtn"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.3"
            android:background="@drawable/overlay_btn_primary"
            android:gravity="center"
            android:text="Quick Add"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
